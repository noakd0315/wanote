# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# Gradle writes reports under android/build during an Android build;
# the root-anchored /build/ above does not cover it.
android/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Cloudflare Workers backend (functions/)
functions/node_modules/
security-rules-test/node_modules/
functions/.wrangler/
functions/dist/
functions/.dev.vars

# Never commit secrets
.env
*.env.local

# Firebase config (generate locally via flutterfire configure)
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Leftover subagent worktree scratch dirs (not part of the project)
.claude/worktrees/

# Firebase emulator state (docker-compose.yml's --export-on-exit target).
# Deliberately untracked: the emulators rewrite this whole directory on
# every shutdown, including binary Firestore/Storage dumps, so committing it
# would churn the history with unreviewable diffs. It exists so local test
# data survives `docker compose down`. To share a fixed dataset instead,
# snapshot a copy under a different name and commit that.
.emulator-data/

# Build-time configuration. The example is tracked; filled-in copies are not.
config/*.json
!config/dart_define.example.json

# Upload-key credentials. The example is tracked; the real file is not.
android/key.properties
*.jks
*.keystore
