<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- The languages iOS is told this app speaks.
	     iOS localizes the UI it presents on the app's behalf -- the camera
	     and photo pickers, the permission alerts, the share sheet -- into
	     the device language, but only from this list. A Flutter app ships
	     with Base.lproj alone, so without this key iOS reads the app as
	     English-only and renders all of that in English even on a Japanese
	     phone. That is what the PM saw when taking a photo from the iPhone
	     (2026-08-17); Android has no equivalent gate, which is why it was
	     already correct there.
	     ja first: it is the fallback when the device language is neither.
	     Declaring more than one also makes iOS offer a per-app 言語 setting
	     under Settings > wanote. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ja</string>
		<string>en</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>wanote</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>wanote</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- 権限の説明文。iOSでは説明文なしにカメラ等へアクセスした時点でアプリが
	     クラッシュし、App Review も通らない。文言は許可ダイアログにそのまま
	     表示されるので、「なぜ必要か」が利用者に伝わる形にしてある。
	     多言語化するには ja.lproj / en.lproj に InfoPlist.strings を置き
	     Xcode プロジェクトへ登録する必要がある（CLOUD_PHASE_TASKS.md E-1）。 -->
	<!-- AdMob application id. Read natively by the Google Mobile Ads SDK
	     before any Dart runs, so it cannot come from the dart-define
	     config file the way the ad *unit* ids do. (Written without the
	     leading double hyphen on purpose: two hyphens in a row are not
	     legal inside an XML comment, and this file is a plist.)

	     Google's published sample id, pairing with the sample ad units in
	     AppConfig. Replace both together with the values from the PM's own
	     AdMob account before release; do not guess one. -->
	<!-- Google sign-in hands control to Safari and needs a way back. iOS
	     routes the callback by URL scheme, and the scheme is the reversed
	     client id from GoogleService-Info.plist. Without this entry the
	     browser opens, the person signs in, and nothing returns to the app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.715210245467-vo9nsm5e7b2oogavv92v2tovotko144c</string>
			</array>
		</dict>
	</array>
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
	<key>NSCameraUsageDescription</key>
	<string>ワクチン証明書や愛犬の写真を撮影するためにカメラを使用します。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>愛犬の写真や証明書の画像を選ぶために写真ライブラリを使用します。</string>
	<key>NSFaceIDUsageDescription</key>
	<string>アプリのロック解除にFace IDを使用します。生体情報が端末外へ送信されることはありません。</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>無料版で表示される広告をあなたに合った内容にするために使用します。許可しなくてもアプリのすべての機能をご利用いただけます。</string>
</dict>
</plist>
