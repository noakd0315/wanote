rules_version = '2';

// Access control for Cloud Storage, the counterpart to firestore.rules.
//
// Every file the app uploads lives under `users/{uid}/pets/{petId}/...`
// (pet photos, health-record photos, toilet-record photos, vaccination
// certificate scans), so ownership is again the uid in the path. This file
// replaced an `allow read, write: if true` placeholder.
//
// Certificate scans in particular are photographs of medical documents, so
// read access matters as much as write: these must never be world-readable,
// and Storage download URLs are guessable enough that "nobody knows the path"
// is not protection.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);

      // Uploads are additionally capped and typed. Everything the app writes
      // here is a photo it compressed itself, so anything larger or of
      // another type is either a bug or someone using the bucket as free
      // storage.
      allow create, update: if isOwner(uid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Split out from the write above because `request.resource` is null on
      // a delete -- folding them together would make deleting impossible.
      allow delete: if isOwner(uid);
    }

    // No other path is writable or readable.
  }
}
