<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Medication and prevention reminders (spec 5.2 / 5.3), scheduled
         locally by flutter_local_notifications.

         POST_NOTIFICATIONS is required from Android 13; the app asks for it
         at the moment the first reminder is actually scheduled, not at
         launch.

         RECEIVE_BOOT_COMPLETED lets the plugin re-register pending
         reminders after a reboot. Without it, restarting the phone silently
         cancels every scheduled dose reminder.

         Deliberately NOT declared: SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM.
         Google Play restricts those to apps whose core purpose is alarms or
         calendars, and on Android 14 the user has to grant them by hand --
         a denial would mean reminders that never fire at all. See
         ReminderNotificationAdapter for the inexact-alarm tradeoff. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- enableOnBackInvokedCallback opts in to Android's predictive back
         gesture. Without it the system never sends the back events, so
         Flutter's PredictiveBackPageTransitionsBuilder silently falls back to
         a plain animation no matter what the theme asks for. Needs Android
         14+ at runtime; older versions ignore it. -->
    <application
        android:label="wanote"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- flutter_local_notifications' own receivers. The scheduled-notification
             one is what actually posts a reminder when its alarm fires; the boot
             one re-registers pending alarms after a restart, which Android
             otherwise drops. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
